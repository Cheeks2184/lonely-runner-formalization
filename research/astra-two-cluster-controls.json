      "from fractions import Fraction as F",
      "from math import ceil, floor",
      "from collections import Counter",
      "import json",
      "",
      "def norm(x):",
      "    return min(x % 1, (-x) % 1)",
      "",
      "counts = Counter()",
      "for N, M in [(4,1),(5,2),(6,3),(8,5),(10,7),(14,10),(6,4),(6,5)]:",
      "    delta, L, U = F(1,N), F(1,N), F(N-2,N*M)",
      "    for P in range(M+1, M+1+3*N):",
      "        lo, hi = P*L-(1-delta), P*U-(1-delta)",
      "        residue_condition = P*(N-2-M) >= M*(N-1-P%N)",
      "        interval_condition = ceil(lo) <= floor(hi)",
      "        assert residue_condition == interval_condition",
      "        assert ceil(lo) == P//N",
      "        if residue_condition:",
      "            k = P//N",
      "            t = max(L, (k+delta)/(P-M))",
      "            y = P*t-k",
      "            assert L <= t <= U and M*t+delta <= y <= 1-delta",
      "            counts['nonempty_cells'] += 1",
      "        else:",
      "            counts['empty_cells'] += 1",
      "        counts['scalar_cases'] += 1",
      "",
      "fixtures = []",
      "for M in range(1,7):",
      "    full = tuple(range(1,M+1))",
      "    for A,B in [(full,(1,)),((M,),full),(full,full)]:",
      "        N = len(A)+len(B)+2",
      "        d = N-2-M",
      "        assert d > 0",
      "        p0 = M + ceil(F(M*(N-1),d))",
      "        for p in (p0,p0+1,N*10**12):",
      "            fixtures.append((M,A,B,p))",
      "fixtures += [(5,(1,3,5),(1,2,5),40),",
      "             (7,(1,2,5,7),(2,3,5,7),70),",
      "             (10,(1,2,4,6,9,10),(1,3,5,6,8,10),75)]",
      "for M,A,B,p in fixtures:",
      "    assert len(set(A))==len(A) and len(set(B))==len(B)",
      "    assert all(1<=a<=M for a in A+B)",
      "    N = len(A)+len(B)+2",
      "    assert M < N-2 and p >= 2*M+1",
      "    assert (p-M)*(N-2-M) >= M*(N-1)",
      "    T = (0,)+A+tuple(p-b for b in B)+(p,)",
      "    reflected = (0,)+B+tuple(p-a for a in A)+(p,)",
      "    assert len(set(T)) == len(T) == N",
      "    assert set(p-s for s in T) == set(reflected)",
      "    for r in T:",
      "        u = r if r<=M else p-r",
      "        P = p-u",
      "        k = P//N",
      "        delta = F(1,N)",
      "        t = max(delta,(k+delta)/(P-M))",
      "        y = P*t-k",
      "        assert t>0 and delta<=t<=F(N-2,N*M)",
      "        assert M*t+delta<=y<=1-delta",
      "        vals = [norm(t*(s-r)) for s in T if s!=r]",
      "        assert len(vals)==N-1 and min(vals)>=delta",
      "        counts['chosen_runners'] += 1",
      "        counts['signed_comparisons'] += len(vals)",
      "        counts['closed_equalities'] += sum(v==delta for v in vals)",
      "        counts['upper_chosen'] += r>M",
      "    counts['configurations'] += 1",
      "    counts['odd_count_configurations'] += N%2",
      "    counts['nonmatching_configurations'] += set(A)!=set(B)",
      "    counts['uniform_bound_equalities'] += (p-M)*(N-2-M)==M*(N-1)",
      "",
      "# Empty first-band cell does not refute the canonical witness problem.",
      "M,N,p=5,6,11",
      "T=(0,1,5,6,10,11)",
      "assert F(1,N)>F(N-2,N*M)",
      "assert all(norm(F(1,4)*s)>=F(1,N) for s in T if s!=0)",
      "assert all(counts[k]>0 for k in ['odd_count_configurations','nonmatching_configurations',",
      "                               'uniform_bound_equalities','closed_equalities'])",
      "print(json.dumps(dict(counts),sort_keys=True))"
    ],
