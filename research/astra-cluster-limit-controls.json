  "correction_history": "Initial checker returned t0 from lower() after checking tp; reflected upper checks therefore used the wrong time. It now returns tp. Counts are derived from the literal domains: sum |A| = sum |B| = 15 over four p values, giving 60 lower and 60 reflected upper runs. D uses actual differences {a-r} minus zero. The free-high check is unconditional as norm(y0-b*t0), including singleton rules. Root integration review renamed the 18 near-bound cases and separately counted the 6 exact bound equalities, and added explicit t0 normalization assertion. D in this checker denotes the signed auxiliary set; its fixed witness threshold is sufficient but need not use the smaller absolute-value deduplication cardinality.",
  "code_lines": [
    "from fractions import Fraction as F",
    "",
    "PAIRS=[({0,1,5},{0,2,9}),({0},{0,1,4}),({0,2},{0}),({-4,0,3},{-5,0,2,8}),({0,1},{0,3}),({0,1,2,7},{0,4})]",
    "",
    "def norm(x):",
    "    z=x%1",
    "    return min(z,1-z)",
    "",
    "def witness(D):",
    "    delta=F(1,len(D)+1)",
    "    candidates=set()",
    "    for w in D:",
    "        a=abs(w)",
    "        for j in range(a):",
    "            candidates.add(F(j, a)+delta/F(a))",
    "            candidates.add(F(j+1, a)-delta/F(a))",
    "    for x in sorted(candidates):",
    "        if x>0 and x<2 and all(norm(w*x)>=delta for w in D):",
    "            return x+1",
    "    raise AssertionError(('no fixed endpoint witness',D))",
    "",
    "def lower(A,B,p,r):",
    "    N=len(A)+len(B)",
    "    K=max(max(A)-min(A),max(B)-min(B))",
    "    delta=F(1,N); eps=F(1,N*(N-1)); P=p-r",
    "    if len(A)==1:",
    "        t0=F(1); y0=F(1,2); D=set()",
    "    else:",
    "        d=min(A-{r})-r",
    "        assert d",
    "        b=max(B) if d>0 else min(B)",
    "        c=b+d",
    "        assert c not in B",
    "        D=({a-r for a in A}-{0}) | {c-x for x in B}",
    "        assert 0 not in D and len(D)<=N-2 and d in D",
    "        t0=witness(D); y0=c*t0",
    "    assert 1<=t0<2",
    "    q=(P*t0-y0+F(1,2)).numerator//(P*t0-y0+F(1,2)).denominator",
    "    tp=(q+y0)/P",
    "    assert tp>0 and abs(tp-t0)<=F(1,2*P)",
    "    T=set(A)|{p-b for b in B}",
    "    assert len(T)==N and set(A).isdisjoint({p-b for b in B})",
    "    assert all(norm((a-r)*t0)>=delta+eps for a in A if a!=r)",
    "    assert all(norm(y0-b*t0)>=delta+eps for b in B)",
    "    assert all(norm((s-r)*tp)>=delta for s in T if s!=r)",
    "    shift=tp-t0",
    "    low=max([abs((a-r)*shift) for a in A if a!=r] or [F(0)])",
    "    high=max([abs((-b)*shift) for b in B] or [F(0)])",
    "    assert low<=F(K,2*P)<=eps and high<=F(K,2*P)<=eps",
    "    return len(D),tp",
    "",
    "def run():",
    "    counts={'fixtures':0,'p_values':0,'lower_runs':0,'upper_reflections':0,'endpoint_witnesses':0,'singleton_rules':0,'signed_comparisons':0,'error_bounds':0,'near_bound_p_values':0,'bound_equalities':0,'two_runner':0}",
    "    for A,B in PAIRS:",
    "        N=len(A)+len(B); assert N>=3",
    "        K=max(max(A)-min(A),max(B)-min(B)); assert K>=1",
    "        R=max(max(A),max(B)); C=N*(N-1)//2",
    "        for off in (0,1,137,10**12):",
    "            p=R+C*K+off",
    "            T=set(A)|{p-b for b in B}; assert len(T)==N and set(A).isdisjoint({p-b for b in B})",
    "            for r in A:",
    "                d,t=lower(A,B,p,r); counts['lower_runs']+=1",
    "                counts['endpoint_witnesses']+=bool(d); counts['singleton_rules']+=not bool(d)",
    "                counts['signed_comparisons']+=N-1; counts['error_bounds']+=2",
    "            for r in {p-b for b in B}:",
    "                rp=p-r; assert rp in B",
    "                d,t=lower(B,A,p,rp); counts['upper_reflections']+=1",
    "                # reflected differences negate original differences, checked exactly.",
    "                assert all(norm((s-r)*t)>=F(1,N) for s in T if s!=r)",
    "                counts['endpoint_witnesses']+=bool(d); counts['singleton_rules']+=not bool(d)",
    "                counts['signed_comparisons']+=N-1; counts['error_bounds']+=2",
    "            counts['p_values']+=1",
    "            counts['near_bound_p_values']+=off in (0,1,137)",
    "            counts['bound_equalities']+=off==0",
    "        counts['fixtures']+=1",
    "    for p in (1,10):",
    "        t=F(1,2*p); T={0,p}",
    "        assert all(norm((s-r)*t)>=F(1,2) for r in T for s in T if s!=r)",
    "        counts['two_runner']+=1",
    "    expected={'fixtures':6,'p_values':24,'lower_runs':60,'upper_reflections':60,'endpoint_witnesses':112,'singleton_rules':8,'signed_comparisons':528,'error_bounds':240,'near_bound_p_values':18,'bound_equalities':6,'two_runner':2}",
    "    assert counts==expected,(counts,expected)",
    "    print(counts)",
    "if __name__=='__main__': run()"
  ],
