    "code_lines": [
      "import hashlib",
      "import json",
      "import math",
      "from pathlib import Path",
      "",
      "ROOT = Path.cwd()",
      "INVENTORY = ROOT / 'research' / 'astra-cover-corpus-inventory.json'",
      "AUTHOR_NOTE = ROOT / 'research' / 'astra-endpoint-label-audit.md'",
      "data = json.loads(INVENTORY.read_text())",
      "assert hashlib.sha256(AUTHOR_NOTE.read_bytes()).hexdigest() == data['source_inventory']['accepted_source_sha256']",
      "assert data['scope']['fixtures_recomputed'] == len(data['fixtures']) == 10",
      "",
      "def distance(modulus, value):",
      "    return min(value % modulus, (-value) % modulus)",
      "",
      "checked = []",
      "for fixture in data['fixtures']:",
      "    N = fixture['N']",
      "    p = fixture['p']",
      "    owners = fixture['owners']",
      "    M = N * p",
      "    assert M == fixture['M']",
      "    assert all(a > 0 for a in owners) == fixture['positive'] == True",
      "    assert len(set(owners)) == len(owners) == fixture['c']",
      "    assert fixture['distinct'] is True",
      "    assert all(a < p for a in owners) == fixture['all_owners_lt_p'] == True",
      "    assert fixture['c'] == fixture['N_minus_2'] == N - 2",
      "    assert math.gcd(*owners, p) == fixture['tuple_gcd'] == 1",
      "    assert math.gcd(*owners) == fixture['lower_gcd']",
      "    assert fixture['primitive_normalization'] == 'already primitive'",
      "    R = {r for r in range(M) if r % N != 0}",
      "    bad = {a: {r for r in R if distance(M, r * a) < p} for a in owners}",
      "    union = set().union(*bad.values())",
      "    safe = sorted(R - union)",
      "    assert len(R) == fixture['candidate_count']",
      "    assert len(union) == fixture['union_count']",
      "    assert safe == fixture['safe_residues'] == []",
      "    assert {str(a): len(bad[a]) for a in owners} == fixture['bad_counts']",
      "    assert (union == R) == fixture['actual_pivot_covered'] == True",
      "    checked.append(fixture['id'])",
      "",
      "assert data['result']['all_accepted_rows_literal_covered'] is True",
      "assert data['result']['all_accepted_have_c_equals_N_minus_2'] is True",
      "assert data['result']['all_accepted_full_tuples_primitive'] is True",
      "print(json.dumps({'checked': checked, 'fixtures': len(checked), 'largest_checked_modulus': max(x['M'] for x in data['fixtures']), 'source_hash': hashlib.sha256(AUTHOR_NOTE.read_bytes()).hexdigest()}, sort_keys=True, separators=(',', ':')))"
    ],
    "method": "Direct finite construction of the one named row and the union of its named owner bad sets. No tuple generation, branching search, or legacy/quarantined executable was invoked."
  },
