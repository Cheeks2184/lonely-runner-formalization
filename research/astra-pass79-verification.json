    "source": "from pathlib import Path\nimport hashlib\nimport json\nimport subprocess\nimport sys\nroot=Path('/home/joshua/lonely-runner-formalization')\nm=json.loads(Path('/tmp/astra-pass79-inputs.json').read_text())\nfor name,digest in (m['hashes'] | m['dependency_hashes']).items():\n    data=(root/name).read_bytes()\n    assert hashlib.sha256(data).hexdigest()==digest,name\n    assert data.endswith(b'\\n'),name\n    assert all(line.rstrip()==line for line in data.splitlines()),name\nfor b in m['document_bindings']:\n    assert b['sha256'] in (root/b['document']).read_text(),b\n    if b['kind']=='repository':\n        assert hashlib.sha256((root/b['path']).read_bytes()).hexdigest()==b['sha256'],b\n    elif b['kind']=='external':\n        assert hashlib.sha256(Path(b['path']).read_bytes()).hexdigest()==b['sha256'],b\n    else:\n        assert b['kind']=='historical_initial_author',b\n        assert b['sha256']=='b1830a7afa75b9283d2f45344ed29cbbe2512033d60f93fa34580789acf068d1',b\nexternal=m['external_source']\nassert len(Path(external['local_path']).read_bytes())==external['bytes']\nassert hashlib.sha256(Path(external['local_path']).read_bytes()).hexdigest()==external['sha256']\ncommands=[]\nfor argv in ([sys.executable,'-B','scripts/validate_workflow.py'],['git','diff','--check'],[sys.executable,'-B','scripts/manage_storage.py']):\n    r=subprocess.run(argv,cwd=root,capture_output=True,text=True)\n    commands.append(dict(argv=argv,exit_code=r.returncode,stdout=r.stdout,stderr=r.stderr))\n    assert r.returncode==0,commands[-1]\nprint(json.dumps(dict(frozen_files=len(m['hashes']),dependency_bindings=len(m['dependency_hashes']),document_bindings=len(m['document_bindings']),external_source_verified=True,historical_initial_author_compared_to_current=False,numerical_replay=False,local_lean_build=False,commands=commands),indent=2))\n",
    "source_sha256": "33b0c6f7d583e62b570d6d5ad0b6be894072482c87f0032376d040b6072cccf3",
