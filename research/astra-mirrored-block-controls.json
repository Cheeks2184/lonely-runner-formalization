  "reproducer": {
    "code_lines": [
      "from fractions import Fraction as F",
      "from collections import Counter",
      "import json",
      "",
      "def norm(x):return min(x%1,(-x)%1)",
      "counts=Counter()",
      "large=[]",
      "fixtures=[(m,p) for m in range(1,33) for p in range(2*m+1,2*m+1+3*(2*m+2))]",
      "for m in (10,100,1000):",
      " N=2*m+2",
      " fixtures.extend((m,p) for p in [2*m+1,2*m+2,2*m+3]+[N*10**12+r for r in (0,m,m+1,N-1)])",
      "for m,p in fixtures:",
      " N=2*m+2;d=F(1,N);k,r=divmod(p,N)",
      " t=d if r>=m+1 else F(N*k+1,N*(p-m))",
      " A=set(range(1,m+1))|set(range(p-m,p))|{p}",
      " assert len(A)==2*m+1 and min(A)>0 and max(A)==p",
      " assert d<=t<=2*d and all(norm(a*t)>=d for a in A)",
      " y=p*t-k",
      " assert m*t+d<=y<=1-d",
      " assert all(F(1,N)<=i*t<=1-d and d<=y-i*t<=1-d for i in range(1,m+1))",
      " counts['tuples']+=1;counts['original_speed_checks']+=len(A)",
      " counts['first_case' if r>=m+1 else 'adjusted_case']+=1",
      " counts['p_at_minimum']+=p==2*m+1",
      " counts['p_multiple_N']+=r==0",
      " counts['r_equals_m']+=r==m",
      " counts['r_equals_m_plus_one']+=r==m+1",
      " if p>10**12:large.append({'m':m,'p':p,'time':str(t),'minimum_norm':str(min(norm(a*t) for a in A))})",
      "assert counts['first_case'] and counts['adjusted_case'] and counts['p_at_minimum']",
      "print(json.dumps({'counts':dict(counts),'large_height_fixtures':large},sort_keys=True))"
    ],
    "sha256": "520c6a231d9f644a3319eb06e5a43ca1b838a9b9d66a00338b033da843294e4c",
