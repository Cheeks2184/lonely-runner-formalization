    "code_lines": [
      "import json",
      "from fractions import Fraction as F",
      "from math import lcm",
      "from pathlib import Path",
      "",
      "data = json.loads((Path.cwd() / 'research' / 'astra-first-blocker-controls.json').read_text())",
      "",
      "def parse(x): return F(x)",
      "def norm(x): return min(x % 1, (-x) % 1)",
      "def components(N, V):",
      "    out = [(F(0), F(1))]",
      "    for a in V:",
      "        bands = [(F(N*j + 1, N*a), F(N*(j + 1) - 1, N*a)) for j in range(a)]",
      "        raw = [(max(L, x), min(R, y)) for L, R in out for x, y in bands if max(L, x) <= min(R, y)]",
      "        raw.sort()",
      "        out = []",
      "        for x, y in raw:",
      "            if out and x <= out[-1][1]: out[-1] = (out[-1][0], max(out[-1][1], y))",
      "            else: out.append((x, y))",
      "    return out",
      "def first_full_component(N, V, b, old):",
      "    for L, R in old:",
      "        for j in range(b):",
      "            x, y = F(N*j + 1, N*b), F(N*(j + 1) - 1, N*b)",
      "            if max(L, x) <= min(R, y): return max(L, x), min(R, y)",
      "    return None",
      "",
      "out = []",
      "for f in data['fixtures']:",
      "    N, V = f['N'], tuple(f['V'])",
      "    got = components(N, V)",
      "    expected = [(parse(x), parse(y)) for x, y in f['components']]",
      "    assert got == expected",
      "    E = [z for pair in got for z in pair]",
      "    assert E == [parse(x) for x in f['endpoints']]",
      "    W = max(y - x for x, y in got)",
      "    T = N * lcm(*V)",
      "    assert str(W) == f['W'] and T == f['T']",
      "    predicate = lambda q: all(norm(q*e) < F(1, N) for e in E)",
      "    b = next(q for q in range(1, T + 1) if predicate(q))",
      "    assert b == f['b'] and predicate(b)",
      "    assert all(not predicate(q) for q in range(1, b)) == f['all_prior_q_fail'] == True",
      "    phases = [(b*e) % 1 for e in E]",
      "    assert [str(x) for x in phases] == f['endpoint_phases_mod_one']",
      "    assert all(x.denominator == 1 for x in (b*e for e in E)) == f['integral_at_all_endpoints']",
      "    assert str(b*W) == f['bW']",
      "    full = first_full_component(N, V, b, got)",
      "    assert full == tuple(parse(x) for x in f['full_witness_component'])",
      "    point = parse(f['full_witness_point'])",
      "    assert full[0] <= point <= full[1]",
      "    assert all(norm(point*a) >= F(1, N) for a in V + (b,))",
      "    out.append({'id': f['id'], 'b': b, 'T': T, 'bW': str(b*W), 'full_witness_point': str(point)})",
      "print(json.dumps(out, sort_keys=True, separators=(',', ':')))"
    ],
    "method": "Fixed closed-band intersections and fixed-q exact Fraction tests. The full witness check scans only b closed bands against previously computed old components and returns the first overlap; it does not enumerate any b*N residue grid."
